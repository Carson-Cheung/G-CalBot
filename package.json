{
  "name": "g-calbot",
  "version": "1.0.0",
  "private": true,
  "description": "Discord bot and Activity for calendar reminders, multi-calendar sync and schedule sharing",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npm run build:web && npm run typecheck",
    "build:web": "esbuild src/web/main.tsx --bundle --outfile=public/js/app.js --format=esm --platform=browser --target=es2020 --minify",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/web",
    "start": "tsx src/index.ts",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "license": "ISC",
  "dependencies": {
    "@discord/embedded-app-sdk": "^2.5.0",
    "cors": "^2.8.6",
    "discord-api-types": "^0.38.57",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "lucide-react": "^1.61.0",
    "node-ical": "^0.27.3",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.3"
  }
}
