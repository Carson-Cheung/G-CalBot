# Discord Application Credentials (from https://discord.com/developers/applications)
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_CLIENT_SECRET=your_client_secret_here

# Web & Activity Server Port (default 3000)
PORT=3000

# Calendar Sync Frequency in minutes (default 5)
SYNC_INTERVAL_MINUTES=5

# Optional Neon PostgreSQL Connection String
DATABASE_URL=
