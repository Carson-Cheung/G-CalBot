# Discord application credentials (https://discord.com/developers/applications)
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_CLIENT_SECRET=your_client_secret_here

# Secret used to sign dashboard sessions (32+ characters).
# Falls back to DISCORD_CLIENT_SECRET if unset. Changing it signs everyone out.
SESSION_SECRET=

# Public URL of the web dashboard (RENDER_EXTERNAL_URL is used automatically on Render)
PUBLIC_URL=

# Web server port (default 3000)
PORT=3000

# Number of reverse proxies in front of the app, used for client IPs in rate limiting (default 1)
TRUST_PROXY_HOPS=1

# Calendar sync interval in minutes (default 5)
SYNC_INTERVAL_MINUTES=5

# Optional PostgreSQL connection string; local JSON storage is used when empty
DATABASE_URL=

# Optional path for the local JSON store (default data/database.json)
STORAGE_PATH=

# Optional Discord user ID that receives test DMs from the demo dashboard
OWNER_USER_ID=
